# =======================================================
# CODE SPACE TECHLAB AI QUALITY CONTROL ENVIRONMENT CONFIG
# =======================================================

# Application
APP_NAME="Code Space Techlab AI Quality Control & Complaint System"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Configuration (SQLite default for MVP, PostgreSQL for future prod)
DB_PATH="data/quality_ai.db"

# Embedding Model (Offline HuggingFace model cache)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
CHROMA_PERSIST_DIRECTORY="data/vector_store"

# Local LLM Integration (Ollama default)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:latest"

# Optional Hosted LLM Provider (Only enabled with explicit authorization)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
USE_MOCK_LLM_IF_UNAVAILABLE=true

# Hybrid Search Settings
TOP_K_RETRIEVAL=5
HYBRID_ALPHA=0.6
